{
  "name": "nuestro-rincon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backup": "tsx scripts/backup.ts",
    "build:cloud": "npm run check && node scripts/build-cloud.mjs",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-fotosconailu \"npx vitest run tests/cloud-rules.test.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "file-type": "^22.1.1",
    "firebase": "^13.0.0",
    "heic-to": "1.6.5",
    "helmet": "^8.3.0",
    "lucide-react": "^1.52.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tus-js-client": "4.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "@grpc/grpc-js": "^1.13.6"
  }
}
