# Elegir una contraseña propia; no publicar este archivo con valores reales.
APP_PASSWORD=
PORT=3001
DATA_DIR=./data
BACKUP_DIR=./backups
# Producción: URL HTTPS exacta, sin barra final.
APP_ORIGIN=
MAX_FILE_MB=200
MAX_STORAGE_MB=1024
# 1 si hay exactamente un proxy de confianza delante (por ejemplo Render).
TRUST_PROXY=0

# Hosting gratuito: configurar las tres variables juntas. Nunca usar prefijo VITE_.
# DATABASE_URL: conexión PostgreSQL mediante Session pooler (IPv4), TLS verificado.
DATABASE_URL=
# CA PEM del proveedor o ruta al archivo de certificado, si su CA no es pública.
DATABASE_CA=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BRIDGE_TOKEN=
SUPABASE_BUCKET=rincon-render
# Modo remoto: límites fijos de 50.000.000 bytes/archivo y 900.000.000 totales,
# incluyendo miniaturas. MAX_FILE_MB/MAX_STORAGE_MB sólo configuran modo local.

# Modalidad cloud: usar .env.cloud para build:cloud, con claves PUBLICAS únicamente.
# VITE_CLOUD=firebase
# VITE_SUPABASE_URL=https://REFERENCIA.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Mapa: valores gratuitos por defecto; no requiere claves ni cuentas nuevas.
# Búsqueda manual de direcciones (proxy privado, caché y límite propio1/s).
PLACES_SEARCH_URL=https://photon.komoot.io/api/
# Para cambiar proveedor de tiles, configurar URL al compilar y origen en servidor;
# conservar atribución del proveedor en PlaceCanvas.tsx. No incluir secretos.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ORIGIN=https://tile.openstreetmap.org
