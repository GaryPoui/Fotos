rules_version = '2';
// One admin-provisioned shared member account (rincon=true, role=authenticated).
// No public profiles. All documents below are private to the couple.
// createdAt is a server timestamp; date/since remain YYYY-MM-DD UI strings.
service cloud.firestore {
 match /databases/{database}/documents {
  function isMember() {
   return request.auth != null && request.auth.token.rincon == true && request.auth.token.role == 'authenticated';
  }
  function text(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
  function date(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function tag(tags, index) { return tags.size() <= index || text(tags[index], 1, 30); }
  function tags(v) {
   return v is list && v.size() <= 10 && tag(v,0) && tag(v,1) && tag(v,2) && tag(v,3) && tag(v,4)
    && tag(v,5) && tag(v,6) && tag(v,7) && tag(v,8) && tag(v,9);
  }
  function isValidMedia(d, id) {
   return d.keys().hasAll(['id','kind','title','date','album','tags','favorite','artist','mime','size','createdAt','ext','storedBytes'])
    && d.keys().hasOnly(['id','kind','title','date','album','tags','favorite','artist','mime','size','createdAt','ext','storedBytes'])
    && id.matches('^[a-f0-9-]{36}$') && d.id == id
    && text(d.title,1,150) && date(d.date) && text(d.album,0,80) && tags(d.tags)
    && d.favorite is bool && text(d.artist,0,100) && d.createdAt is timestamp
    && d.size is int && d.size > 0 && d.size <= 50000000
    && d.storedBytes is int && d.storedBytes >= d.size && d.storedBytes <= d.size + 5000000
    && ((d.kind == 'photo' && d.ext in ['jpg','png','gif','webp','avif'] && d.mime in ['image/jpeg','image/png','image/gif','image/webp','image/avif'])
     || (d.kind == 'video' && d.ext in ['mp4','webm'] && d.mime in ['video/mp4','video/webm'])
     || (d.kind == 'audio' && d.ext in ['mp3','wav','ogg','m4a'] && d.mime in ['audio/mpeg','audio/wav','audio/ogg','audio/mp4']));
  }
  function isValidNote(d) {
   return d.keys().hasAll(['type','title','body','author','date','favorite','createdAt'])
    && d.keys().hasOnly(['type','title','body','author','date','favorite','createdAt'])
    && d.type in ['quote','letter'] && text(d.title,1,150) && text(d.body,1,30000)
    && text(d.author,0,100) && date(d.date) && d.favorite is bool && d.createdAt is timestamp;
  }
  function isValidSettings(d) {
   return d.keys().hasAll(['names','title','since']) && d.keys().hasOnly(['names','title','since'])
    && text(d.names,1,100) && text(d.title,1,80) && (d.since == '' || date(d.since));
  }
  match /rincon_media/{id} {
   allow read, delete: if isMember();
   allow create: if isMember() && isValidMedia(request.resource.data,id) && request.resource.data.createdAt == request.time;
   allow update: if isMember() && isValidMedia(request.resource.data,id)
    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id','kind','mime','size','createdAt','ext','storedBytes']);
  }
  match /rincon_notes/{id} {
   allow read, delete: if isMember();
   allow create: if isMember() && isValidNote(request.resource.data) && request.resource.data.createdAt == request.time;
   allow update: if isMember() && isValidNote(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
  }
  match /rincon_settings/{id} {
   allow read: if isMember() && id == 'main';
   allow create, update: if isMember() && id == 'main' && isValidSettings(request.resource.data);
  }
  match /{document=**} { allow read, write: if false; }
 }
}
